FROM debian:12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    openjdk-17-jdk-headless \
    python3 \
    coreutils \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash sandbox
WORKDIR /workspace
RUN chown -R sandbox:sandbox /workspace

USER sandbox